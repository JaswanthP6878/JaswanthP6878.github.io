---
const { heading, desc, link } = Astro.props;
---

<div class="project">
    <a href={link}>
        <div class="heading">
            {heading}
            <span class="arrow">&rightarrow;</span>
        </div>
        <p>{desc}</p>
    </a>
</div>

<style>
    .project {
        border: 1px solid var(--rule);
        border-radius: 4px;
        transition:
            border-color 0.15s ease,
            background-color 0.15s ease;
    }
    .project a {
        display: block;
        height: 100%;
        padding: 0.8rem 1rem;
        text-decoration: none;
        color: var(--ink);
    }
    .heading {
        width: 100%;
        display: flex;
        font-weight: 600;
    }
    .arrow {
        margin-left: auto;
        color: var(--muted-soft);
        transition:
            color 0.15s ease,
            transform 0.15s ease;
    }
    .project:hover {
        border-color: var(--muted-soft);
        background-color: var(--paper-soft);
    }
    .project:hover .heading {
        color: var(--accent);
    }
    .project:hover .arrow {
        color: var(--accent);
        transform: translateX(2px);
    }
    .project p {
        margin: 0.3em 0 0;
        font-size: 0.85rem;
        line-height: 1.45;
        color: var(--muted);
    }
</style>
