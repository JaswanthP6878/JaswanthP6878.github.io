---
const { title, date, url } = Astro.props;
---
<li>
    <h4>
        <a class= "post-link" href={url}>{title}</a>
    </h4>
    <span class="post-meta">{date}</span>
</li>


<style>
    li {
        margin: 0 0 1.1rem;
    }
    h4 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 500;
    }
    .post-link {
        text-decoration: none;
        color: var(--ink);
    }
    .post-link:hover {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: currentColor;
    }

    .post-meta {
        font-size: 0.8rem;
        color: var(--muted);
    }
</style>
