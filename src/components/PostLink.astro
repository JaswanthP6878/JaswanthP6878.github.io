---
interface Props {
    title: string;
    date: string;
    url: string;
    summary?: string;
}

const { title, date, url, summary } = Astro.props;
---
<li class:list={{ "has-summary": summary }}>
    <h4>
        <a class= "post-link" href={url}>{title}</a>
    </h4>
    <span class="post-meta">{date}</span>
    {summary && <p class="post-summary">{summary}</p>}
</li>


<style>
    li {
        margin: 0 0 1.1rem;
    }
    h4 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 500;
    }
    .post-link {
        text-decoration: none;
        color: var(--ink);
    }
    .post-link:hover {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: currentColor;
    }

    .post-meta {
        font-size: 0.8rem;
        color: var(--muted);
    }

    li.has-summary {
        margin-bottom: 1.6rem;
    }

    .post-summary {
        margin: 0.25rem 0 0;
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--ink-soft);
    }
</style>
