<footer>
    <p class = "margin-decrease">
        Made by P Jaswanth
    </p>
    <ul class ="social-list" class ="margin-decrease">
        <li><a href="https://github.com/JaswanthP6878">Github</a></li>
    </ul>
</footer>
<style>
    footer {
        width: 100%;
        margin: 4rem auto 2rem;
        padding-top: 1rem;
        display: flex;
        flex-direction: row;
        align-items: center;
