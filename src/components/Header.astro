---

---

<nav class="navbar">
    <h1 class="brand"><a href="/">Jus<span class = "brand-name">0</span>ne</a></h1>
    <ul class="navLinks">
        <li class="navItem"><a href="/">Home</a></li>
        <li class="navItem"><a href="/blog">Blog</a></li>
    </ul>
</nav>

<style>
    .navbar {
        width: 100%;
        margin: 2rem auto 0;
        display: flex;
        flex-direction: row;
        align-items: baseline;
        justify-content: space-between;
    }

    .brand {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .brand a {
        text-decoration: none;
        color: var(--ink);
    }

    .brand-name {
        font-family: var(--mono);
        font-size: 0.9em;
        color: var(--muted);
        transition: color 0.15s ease;
    }

    .brand:hover .brand-name {
        color: var(--accent);
    }

    .navLinks {
        list-style: none;
        display: flex;
        flex-direction: row;
        gap: 1.4rem;
        margin: 0;
        padding: 0;
    }

    .navItem a {
        text-decoration: none;
        color: var(--ink-soft);
    }

    .navItem a:hover {
        color: var(--accent);
    }

    .linkHighlight a {
        color: var(--accent);
        text-decoration: underline;
        text-decoration-color: currentColor;
        text-underline-offset: 0.3em;
    }
</style>
<script>
    function setnavLinkStyle() {
        const navitems = document.querySelectorAll(".navItem");
        navitems.forEach((item) => {
            if (window.location.pathname == "/" && item.textContent == "Home") {
                item.classList.add("linkHighlight");
            }
            if (
                window.location.pathname.includes("blog") &&
                item.textContent == "Blog"
            ) {
                item.classList.add("linkHighlight");
            }
        });
    }
    document.addEventListener(
        "astro:page-load",
        () => {
            // This only runs once.
            setnavLinkStyle();
        }
    );
</script>
