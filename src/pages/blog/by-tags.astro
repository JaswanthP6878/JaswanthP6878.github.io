---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostLink from "../../components/PostLink.astro";
import { formatTagLabel, getPublishedPosts, sortPosts, tagKey } from "../../lib/blog";

const posts = await getPublishedPosts();
// Grouped case-insensitively; the first spelling seen is used as the heading.
const tagGroups = new Map<string, { label: string; posts: typeof posts }>();

for (const post of posts) {
  for (const tag of new Set(post.data.tags.map(tagKey))) {
    const label = post.data.tags.find((t) => tagKey(t) === tag) ?? tag;
    const group = tagGroups.get(tag) ?? { label, posts: [] };
    group.posts = sortPosts([...group.posts, post]);
    tagGroups.set(tag, group);
  }
}

const sortedTags = [...tagGroups.keys()].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="Blog posts by tag" description="Browse backend and distributed systems posts grouped by topic tags.">
  <div class="headings">
    <h3>Blog Posts by Tag</h3>
    <h3><a class="page-nav-link" href="/blog">Back to all posts</a></h3>
  </div>
  {
    sortedTags.map((tag) => (
      <section>
        <h2 class="tag-name">{formatTagLabel(tagGroups.get(tag)!.label)}</h2>
        <ul class="post-list">
          {tagGroups.get(tag)!.posts.map((post) => (
            <PostLink title={post.data.title} url={`/blog/${post.slug}/`} date={post.data.date} />
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .post-list {
    margin-left: 0;
    padding-left: 0;
    list-style: none;
  }

  .headings {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 16px;
  }

  h3,
  h4 {
    display: inline-block;
  }

  .page-nav-link {
    font-size: 0.9rem;
    font-weight: 400;
    text-decoration: none;
    color: var(--muted);
  }

  .page-nav-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .tag-name {
    margin: 2rem 0 0.75rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 1.25rem;
    font-weight: 500;
  }
</style>
