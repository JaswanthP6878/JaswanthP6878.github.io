---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostLink from "../components/PostLink.astro";
import { getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();
const sortedPosts = posts.slice(0, 3);
---

<BaseLayout title="Home" description="Backend and distributed systems engineering notes, projects, and implementation walkthroughs.">
  <div class="bio">
    <p>
    Hi, I’m Jaswanth. I'm a Systems engineer who builds close to the metal — distributed protocols, network servers, and OS internals. 
    Currently pursuing a Master's in AI at Boston University to bring that depth to ML infrastructure.  </p>
  </div>
  <div class="project">
    <h3>Projects</h3>
    <div class="projectList">
      <ProjectCard
        heading="Chip-8 emulator"
        desc="software emulator for running chip-8 spec games"
        link="https://github.com/JaswanthP6878/chip8-emulator"
      />
      <ProjectCard
        heading="MapReduceMini"
        desc="An implementation map-reduce framework"
        link="https://github.com/JaswanthP6878/MapReduceMini"
      />
      <ProjectCard
        heading="CodeCompete"
        desc="1v1 code platform for friends to compete to solve cp problems."
        link="https://github.com/JaswanthP6878/CodeCompete"
      />
    </div>
  </div>

  <div class="blogPosts">
    <h3>Blog</h3>
    <ul class="postList">
      {
        sortedPosts.map((post) => (
          <PostLink title={post.data.title} url={`/blog/${post.slug}/`} date={post.data.date} />
        ))
      }
    </ul>
  </div>

  <h4 class="allposts"><a href="/blog">All posts &rightarrow;</a></h4>
</BaseLayout>

<style>
  .bio {
    margin-top: 1em;
  }

  .projectList {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    row-gap: 10px;
  }

  .postList {
    margin-left: 0;
    padding-left: 0;
    list-style: none;
    min-height: 20vh;
  }

  .allposts {
    text-align: end;
  }

  .allposts a {
    text-decoration: none;
    color: black;
  }

  .allposts a:hover {
    text-decoration-line: underline;
    color: black;
  }
</style>
