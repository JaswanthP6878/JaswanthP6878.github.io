---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostLink from "../components/PostLink.astro";
import { formatPostDate, getPublishedPosts } from "../lib/blog";

// The home page is the blog: newest posts first, with the full archive linked once it grows.
const HOME_POST_LIMIT = 10;
const posts = await getPublishedPosts();
const homePosts = posts.slice(0, HOME_POST_LIMIT);
const hasMore = posts.length > HOME_POST_LIMIT;
---

<BaseLayout title="Home" description="Backend and distributed systems engineering notes and implementation walkthroughs.">
  <section class="bio">
    <p>
      I'm a backend and systems engineer with experience in distributed backends, Kubernetes internals and storage infrastructure.
      Passionate about distributed systems and how they scale to power modern infrastructure. Currently pursuing a Master's in AI at Boston University to deepen my knowledge and apply it to AI/ML infrastructure.
    </p>
  </section>

  <section class="posts" aria-labelledby="posts-title">
    <h2 id="posts-title" class="section-title">Posts</h2>
    <ul class="post-list">
      {
        homePosts.map((post) => (
          <PostLink
            title={post.data.title}
            url={`/blog/${post.slug}/`}
            date={formatPostDate(post.data.date)}
            summary={post.data.summary}
          />
        ))
      }
    </ul>
    <p class="more-links">
      {hasMore && <a href="/blog">All posts &rarr;</a>}
      <a href="/blog/by-tags">Browse by topic &rarr;</a>
    </p>
  </section>
</BaseLayout>

<style>
  .bio {
    margin: 2.5rem 0 2.75rem;
  }

  .bio p {
    margin: 0;
  }

  .section-title {
    margin: 0 0 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-soft);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more-links {
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
  }

  .more-links a {
    color: var(--muted);
    text-decoration: none;
  }

  .more-links a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: currentColor;
  }
</style>
