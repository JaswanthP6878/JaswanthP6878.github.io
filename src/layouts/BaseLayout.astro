---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ViewTransitions, slide } from "astro:transitions";
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/400-italic.css";
import "@fontsource/eb-garamond/500.css";
import "@fontsource/eb-garamond/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/400-italic.css";
import "@fontsource/jetbrains-mono/600.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
}

const {
  title,
  description = "Engineering blog focused on backend systems, distributed systems, and practical tooling.",
  canonical,
  ogType = "website",
  publishedTime
} = Astro.props;

const canonicalUrl =
  canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // Apply the saved reading width before first paint. Astro's page transitions reset
      // <html> attributes on every navigation, so re-apply it after each swap too.
      (() => {
        const applyReadingWidth = () => {
          let wide = false;
          try {
            wide = localStorage.getItem("reading-width") === "wide";
          } catch {}
          if (wide) document.documentElement.dataset.width = "wide";
          else delete document.documentElement.dataset.width;
        };
        applyReadingWidth();
        document.addEventListener("astro:after-swap", applyReadingWidth);
      })();
    </script>
    <slot name="head" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <link rel="alternate" type="application/rss+xml" title="JP's blog RSS" href="/rss.xml" />

    <ViewTransitions />
  </head>
  <body>
    <Header />
    <main transition:animate={slide({ duration: "0.5s" })}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1a1a;
    --ink-soft: #2a2a2a;
    --muted: #6b6b6b;
    --muted-soft: #9a9a9a;
    --rule: #e5e5e5;
    --rule-soft: #ededed;
    --paper: #fff;
    --paper-soft: #fafafa;
    --accent: #2a4d6e;
    --serif: "EB Garamond", Palatino, "Palatino Linotype", "Book Antiqua", Georgia, serif;
    --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --measure: 38rem;
  }

  /* "Wider" reading mode, toggled from the post header. */
  html[data-width="wide"] {
    --measure: 52rem;
  }

  /* Garamond has a small x-height, so the base size is larger than a sans-serif would need. */
  html {
    font-size: 19px;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  body {
    position: relative;
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 1.5rem;
    transition: max-width 0.25s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    body {
      transition: none;
    }
  }

  main {
    min-height: 70vh;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--ink);
    font-weight: 600;
    line-height: 1.25;
  }

  a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--muted-soft);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.15s ease;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  strong {
    font-weight: 600;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 2.5rem 0;
  }

  blockquote {
    margin: 2rem 0;
    padding: 0.1rem 0 0.1rem 1.4rem;
    border-left: 2px solid var(--rule);
    color: var(--ink-soft);
    font-style: italic;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* ---- Math (MathJax SVG, rendered at build time) ---- */
  /* MathJax sizes itself from the x-height, which is small in Garamond; scale up to match the text. */
  mjx-container[jax="SVG"] {
    font-size: 110%;
  }

  mjx-container[display="true"] {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.15rem 0;
  }

  /* ---- Code ---- */
  code,
  kbd,
  pre,
  samp {
    font-family: var(--mono);
    font-feature-settings: "liga" 0;
  }

  :not(pre) > code {
    font-size: 0.78em;
    color: var(--ink-soft);
    background: var(--paper-soft);
    border: 1px solid var(--rule-soft);
    border-radius: 3px;
    padding: 0.1em 0.35em;
  }

  pre {
    margin: 1.6rem 0;
    padding: 1rem 1.2rem;
    background: var(--paper-soft);
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink);
    font-size: 0.74rem;
    line-height: 1.65;
    overflow-x: auto;
    tab-size: 4;
  }

  pre code {
    font-size: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
  }

  /* Syntax highlighting (Prism tokens): near-monochrome, structure shown with weight and italics. */
  .token.comment,
  .token.prolog,
  .token.doctype,
  .token.cdata {
    color: var(--muted-soft);
    font-style: italic;
  }

  .token.keyword,
  .token.atrule,
  .token.important {
    color: var(--ink);
    font-weight: 600;
  }

  .token.function,
  .token.class-name,
  .token.macro {
    color: var(--accent);
  }

  .token.string,
  .token.char,
  .token.regex,
  .token.url,
  .token.attr-value {
    color: #5a5a5a;
  }

  .token.number,
  .token.boolean,
  .token.constant,
  .token.symbol,
  .token.builtin,
  .token.property,
  .token.attribute,
  .token.lifetime-annotation {
    color: var(--ink-soft);
  }

  .token.punctuation,
  .token.operator {
    color: var(--muted);
  }

  @media screen and (max-width: 600px) {
    html {
      font-size: 18px;
    }

    body {
      padding: 0 1rem;
    }

    pre {
      padding: 0.85rem 1rem;
      font-size: 0.7rem;
    }
  }
</style>
